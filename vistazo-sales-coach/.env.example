# ============================================================
# Vistazo Sales Coach — environment variables
# Copy to .env.local and fill in. NEVER commit real values.
# ============================================================

# --- Supabase ------------------------------------------------
# Project URL and anon key: Supabase Dashboard > Settings > API.
# The anon key is safe for the browser (RLS enforces access).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key: server-side ONLY. Bypasses RLS. Used for
# document ingestion, RAG retrieval and privileged admin ops.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- OpenAI --------------------------------------------------
# Server-side only. Never exposed to the browser.
OPENAI_API_KEY=sk-...

# Models are configurable so the provider/model can be swapped
# without code changes. Defaults are applied if unset.
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_GUARDRAIL_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Realtime voice model (WebRTC). e.g. gpt-realtime
OPENAI_REALTIME_MODEL=gpt-realtime
